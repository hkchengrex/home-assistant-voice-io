[Unit]
Description=Local voice pipeline
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/local-voice
ExecStart=%h/.local/share/local-voice/.venv/bin/local-voice --config %h/.config/local-voice/commands.toml --recordings %h/.local/share/local-voice/recordings run --assets %h/.local/share/local-voice/assets
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

[Unit]
Description=Home Assistant Voice IO
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/voice-io
ExecStart=%h/.local/share/voice-io/.venv/bin/voice-io --config %h/.config/voice-io/commands.toml --recordings %h/.local/share/voice-io/recordings run --assets %h/.local/share/voice-io/assets
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
